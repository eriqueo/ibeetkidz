{
  "name": "ibeetkidz",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Kidpix for audio \u2014 a kid-friendly browser sound playground. Record your voice, make it crazy, layer loops, see the sound.",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && npm run build:gh && npm run check:no-editor",
    "build:gh": "vite build --mode gh",
    "check:no-editor": "bash scripts/check-no-editor-in-dist.sh",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build:gh && playwright test",
    "test:e2e:headed": "npm run build:gh && playwright test --headed",
    "deploy": "npm run build && npm run deploy:cf",
    "deploy:cf": "npx -y wrangler@4 pages deploy ./dist --project-name=ibeetkidz --branch=main --commit-dirty=true"
  },
  "dependencies": {
    "phaser": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tone": "^15.0.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.3",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.8.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.4.1",
    "vitest": "^3.2.3"
  }
}
